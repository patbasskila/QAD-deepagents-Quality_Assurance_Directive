# QAD DeepAgents - example configuration
# Copy to .env for local dev (DO NOT commit secrets).

APP_ENV=local
LOG_LEVEL=INFO

# Where job artifacts are written
TMP_DIR=tmp
JOB_RETENTION_DAYS=14

# ---------------------------------
# LLM
# ---------------------------------
# mock | azure
LLM_MODE=mock

# Azure OpenAI (only used when LLM_MODE=azure)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# ---------------------------------
# Embeddings (RAG)
# ---------------------------------
# huggingface (remote) | local
EMBEDDINGS_PROVIDER=huggingface

# Remote Hugging Face
HF_TOKEN=
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional: custom Inference Endpoint URL
HF_EMBED_ENDPOINT=

# Local embeddings (optional; requires requirements-local.txt)
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBED_DEVICE=cpu
LOCAL_EMBED_BACKEND=auto
LOCAL_EMBED_CACHE_DIR=
LOCAL_EMBED_LOCAL_FILES_ONLY=false

# Some Windows environments need this for torch/transformers
# KMP_DUPLICATE_LIB_OK=TRUE

# ---------------------------------
# UI / debug downloads
# ---------------------------------
# Never enable debug downloads in a production deployment.
SERVER_ALLOW_DEBUG_DOWNLOADS=true

# ---------------------------------
# Email (optional)
# ---------------------------------
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=25
SMTP_FROM=noreply@example.com
